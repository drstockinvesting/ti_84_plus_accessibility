+/* --- accessibility LCD themes ----------------------------------------------
+ * lcd_theme in the settings picks the black-and-white LCD palette:
+ *   0 original green   1 day (black on white)
+ *   2 night (white on black)   3 night amber (amber on black)
+ * Putting it in the settings means one build covers all of them: in portable
+ * mode each Wabbitemu.ini beside the exe chooses its own.
+ * ------------------------------------------------------------------------- */
+static int LCDThemeIndex(void) {
+	static int theme = -1;
+	if (theme < 0) {
+		theme = (int) QueryWabbitKey(_T("lcd_theme"));
+		if (theme < 0 || theme > 3) {
+			theme = 0;
+		}
+	}
+	return theme;
+}
+
+/* Endpoints of each channel's linear ramp: pixel off -> pixel fully on. */
+static void LCDThemeRamp(int theme, int *off, int *on) {
+	static const int ramps[4][6] = {
+		{ 0x9E, 0xAB, 0x88,   0x00, 0x00, 0x00 },	/* original green */
+		{ 0xFF, 0xFF, 0xFF,   0x00, 0x00, 0x00 },	/* day */
+		{ 0x00, 0x00, 0x00,   0xFF, 0xFF, 0xFF },	/* night */
+		{ 0x00, 0x00, 0x00,   0xFF, 0xBF, 0x00 },	/* night amber */
+	};
+	for (int i = 0; i < 3; i++) {
+		off[i] = ramps[theme][i];
+		on[i] = ramps[theme][i + 3];
+	}
+}
