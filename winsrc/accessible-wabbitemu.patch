+/* ---------------------------------------------------------------------------
+ * Accessibility: click-and-hold magnifier.
+ *
+ * Pointer-centred zoom. A client point p is displayed at
+ *     d = Z * (p - c*k),   k = 1 - 1/Z
+ * so the point under the pointer (p == c) is displayed exactly where it
+ * already was. Two consequences this relies on:
+ *   - hit testing needs no inverse transform. The centre follows the mouse, so
+ *     at the moment of a click p == c and the existing keymap lookup (which
+ *     just divides the client point by skin_scale) is still correct.
+ *   - the magnified image can never show anything from outside the window, and
+ *     sweeping the pointer still reaches every corner.
+ * ------------------------------------------------------------------------- */
+static void MagClampCenter(LPMAINWINDOW lpMainWindow) {
+	RECT rc;
+	GetClientRect(lpMainWindow->hwndFrame, &rc);
+	if (lpMainWindow->ptMagCenter.x < rc.left)		lpMainWindow->ptMagCenter.x = rc.left;
+	if (lpMainWindow->ptMagCenter.x > rc.right)		lpMainWindow->ptMagCenter.x = rc.right;
+	if (lpMainWindow->ptMagCenter.y < rc.top)		lpMainWindow->ptMagCenter.y = rc.top;
+	if (lpMainWindow->ptMagCenter.y > rc.bottom)	lpMainWindow->ptMagCenter.y = rc.bottom;
+}
+
+/* Remember where the LCD child sits while the view is not zoomed. */
+static void MagCaptureLCDRect(LPMAINWINDOW lpMainWindow) {
+	RECT r;
+	if (lpMainWindow->bMagnify || lpMainWindow->hwndLCD == NULL) {
+		return;
+	}
+	GetWindowRect(lpMainWindow->hwndLCD, &r);
+	MapWindowPoints(NULL, lpMainWindow->hwndFrame, (LPPOINT) &r, 2);
+	lpMainWindow->rcLCDUnmag = r;
+}
+
+/* Move the LCD child so it lines up with the magnified skin underneath it. The
+ * child scales its own contents to its client rect, so this is all that is
+ * needed for the screen to magnify along with the keys. */
+static void MagPlaceLCD(LPMAINWINDOW lpMainWindow) {
+	RECT r;
+	if (lpMainWindow->hwndLCD == NULL) {
+		return;
+	}
+	r = lpMainWindow->rcLCDUnmag;
+	if (r.right <= r.left || r.bottom <= r.top) {
+		return;		/* never captured a valid unmagnified rect */
+	}
+	if (lpMainWindow->bMagnify) {
+		double k = 1.0 - 1.0 / MAG_Z;
+		double cx = lpMainWindow->ptMagCenter.x * k;
+		double cy = lpMainWindow->ptMagCenter.y * k;
+		r.left		= (LONG)(MAG_Z * (r.left - cx));
+		r.right		= (LONG)(MAG_Z * (r.right - cx));
+		r.top		= (LONG)(MAG_Z * (r.top - cy));
+		r.bottom	= (LONG)(MAG_Z * (r.bottom - cy));
+	}
+	MoveWindow(lpMainWindow->hwndLCD, r.left, r.top,
+		r.right - r.left, r.bottom - r.top, TRUE);
+}
+
+static void SetMagnify(LPMAINWINDOW lpMainWindow, BOOL bOn) {
+	if ((lpMainWindow->bMagnify != FALSE) == (bOn != FALSE)) {
+		return;
+	}
+	if (bOn) {
+		MagCaptureLCDRect(lpMainWindow);
+	}
+	lpMainWindow->bMagnify = bOn;
+	MagClampCenter(lpMainWindow);
+	MagPlaceLCD(lpMainWindow);
+	InvalidateRect(lpMainWindow->hwndFrame, NULL, FALSE);
+}
