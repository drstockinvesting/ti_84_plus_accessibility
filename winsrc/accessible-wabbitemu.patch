+/* --- accessibility: command-line flavour override --------------------------
+ * Day / Night / Amber used to be three separate exes so that one folder could
+ * hold all three: WabbitEmu derives the auto-save from the folder, not from
+ * the INI, so sharing a folder is what lets the flavours share one saved
+ * calculator. Building from source turns that into a command line instead:
+ *
+ *     Wabbitemu.exe -theme night -skin TI-84Plus-Night.png
+ *
+ * -theme takes green|day|night|amber (or 0..3). The override is applied after
+ * the settings are read and is deliberately never written back on exit, so
+ * three shortcuts share one Wabbitemu.ini - and therefore one calculator -
+ * without the last one closed redefining the flavour for the other two.
+ * ------------------------------------------------------------------------- */
+static BOOL g_bCmdLineParsed = FALSE;
+static int g_nThemeOverride = -1;
+static TCHAR g_szSkinOverride[256] = { 0 };
+static TCHAR g_szKeymapOverride[256] = { 0 };
+
+static int ParseThemeName(LPCTSTR lpszName) {
+	if (_tcsicmp(lpszName, _T("green")) == 0 || _tcsicmp(lpszName, _T("original")) == 0) {
+		return 0;
+	} else if (_tcsicmp(lpszName, _T("day")) == 0) {
+		return 1;
+	} else if (_tcsicmp(lpszName, _T("night")) == 0) {
+		return 2;
+	} else if (_tcsicmp(lpszName, _T("amber")) == 0 || _tcsicmp(lpszName, _T("night-amber")) == 0) {
+		return 3;
+	}
+	return _ttoi(lpszName);		/* 0..3 also accepted */
+}
+
+/* Parsed on first use, so nothing has to call this in the right order. */
+static void EnsureCmdLineParsed(void) {
+	if (g_bCmdLineParsed) {
+		return;
+	}
