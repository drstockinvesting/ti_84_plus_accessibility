+/* ------------------------------------------------------------------------
+ *  High-contrast palette
+ *
+ *  This build is for a student with Stargardt disease who reads the screen at
+ *  up to 10x magnification, so TI's black-ink-on-a-white-field display is a
+ *  page-sized glare source. Everything below remaps each frame to cool ink on
+ *  true black.
+ *
+ *  The model is ink on paper. A TI pixel is some coverage of one coloured ink
+ *  laid over a white background, so
+ *
+ *      alpha = 1 - min(r,g,b)/255          how much ink is on this pixel
+ *      ink   = (pixel - 255)/alpha + 255   the ink's own colour, un-mixed
+ *
+ *  By construction min(ink) is exactly 0, so the ink is always fully saturated
+ *  and carries just two free numbers: hue and value. Black ink falls out as
+ *  value 0, which is what lets grey text and anti-aliased edges come through
+ *  as a clean grey ramp rather than a coloured halo.
+ *
+ *  Output is alpha * newInk over black, so coverage survives the remap: the
+ *  white field becomes true black, and a faint anti-aliased edge stays faint
+ *  instead of blooming into a ring around every glyph.
+ * ---------------------------------------------------------------------- */
+
+/* Source hue -> replacement hue, in degrees. Cool hues keep their identity and
+ * the warm ones are folded into the gaps between them, which is the "cool
+ * first, warm last" priority this was asked for. Folding 360 degrees of source
+ * into 190 degrees of cool costs separation somewhere, so the anchors are
+ * placed to spend it on the colours that are rarely used: TI-OS assigns
+ * Y1..Y5 blue, red, black, magenta and green, and those five stay far apart
+ * while orange and brown -- the two warmest -- end up as neighbours. */
+static const struct { int from, to; } sHueAnchors[] = {
+    {   0, 325 },   /* red     -> pink    */
+    {  31, 248 },   /* orange  -> indigo  */
+    {  60, 163 },   /* yellow  -> aqua    */
+    { 120, 138 },   /* green   -> green   */
+    { 201, 190 },   /* ltblue  -> cyan    */
+    { 240, 222 },   /* blue    -> blue    */
+    { 300, 277 },   /* magenta -> purple  */
+};
+
+/* Nearest anchor wins, rather than interpolating between them. Interpolation
+ * looks tidier but the table is deliberately not monotone -- red sits next to
+ * magenta at one end and orange at the other -- so a smooth sweep between two
+ * anchors would pass straight through a third anchor's colour. Brown, whose
+ * hue is 9 degrees off orange's, came out indistinguishable from navy that
+ * way. Snapping costs some banding on photographic content, which the
+ * calculator does not show, and buys separation on content it does. */
+static qreal remapHue(qreal hue) {
+    const size_t count = sizeof(sHueAnchors) / sizeof(sHueAnchors[0]);
+    qreal best = sHueAnchors[0].to, bestDist = 360.0;
+    for (size_t i = 0; i < count; i++) {
+        qreal dist = qAbs(hue - sHueAnchors[i].from);
+        dist = qMin(dist, 360.0 - dist);
+        if (dist < bestDist) {
+            bestDist = dist;
+            best = sHueAnchors[i].to;
+        }
+    }
+    return best;
+}
+
+/* Relative luminance, so every ink can be held above a contrast ratio on black.
+ * 4.5:1 is the floor: blue is intrinsically dark and pinning it any higher
+ * washed navy and blue into the same colour. */
+static const qreal sMinLuminance = 0.175;   /* (4.5 * 0.05) - 0.05 */
+
+static qreal luminance(const QColor &c) {
+    static qreal linear[256];
+    static bool ready = false;
+    if (!ready) {
+        for (int i = 0; i < 256; i++) {
+            const qreal v = i / 255.0;
+            linear[i] = v <= 0.03928 ? v / 12.92 : std::pow((v + 0.055) / 1.055, 2.4);
+        }
+        ready = true;
+    }
+    return 0.2126 * linear[c.red()] + 0.7152 * linear[c.green()] + 0.0722 * linear[c.blue()];
+}
+
+/* The panel hands us RGB565 widened by bit replication (lcd_argb8888out), so
+ * keying a table on the 565 form is exact for real frames and no worse than a
+ * rounding for anything else. 64K entries keeps the draw path to one load per
+ * pixel. */
+static void unpack565(int i, int &r, int &g, int &b) {
+    r = (i >> 11 & 0x1F) << 3; r |= r >> 5;
+    g = (i >>  5 & 0x3F) << 2; g |= g >> 6;
+    b = (i       & 0x1F) << 3; b |= b >> 5;
+}
+
+/* The tail both maps share: turn a mark's own colour into its replacement ink
+ * and lay that ink over black at `coverage`. `hue` (negative for a neutral) and
+ * `value` describe the mark. `chroma` is the *source* pixel's HSV saturation and
+ * is deliberately not taken from the mark, because un-mixing an ink from white
+ * leaves it fully saturated by construction; without the guard a source that is
+ * only faintly tinted comes back at full strength. That is not academic -- the
+ * panel gives each channel its own gamma curve, so a backlit white is never
+ * exactly neutral, and an idle-dimmed screen turned the whole background into
+ * saturated purple. */
+static QRgb inkOver(qreal hue, qreal value, qreal chroma, qreal coverage, bool mono) {
+    if (coverage <= 0.0) {
+        return qRgb(0, 0, 0);
+    }
+    QColor ink = Qt::white;
+    if (!mono && value > 0.0 && hue >= 0.0) {
+        const qreal target = remapHue(hue * 360.0) / 360.0;
+        /* A darker ink (navy beside blue, brown beside orange) comes back mostly
+         * as a deeper version of its hue rather than a dimmer one, because
+         * dimming is the one thing this student cannot afford. Some of the
+         * difference still has to ride on brightness or the two collapse into a
+         * single colour, hence the small value term. */
+        qreal sat = qMin(1.0, 0.50 + 0.45 * (1.0 - value));
+        qreal val = qMin(1.0, 0.66 + 0.34 * value);
+        const qreal ramp = qBound(0.0, (chroma - 0.15) / 0.40, 1.0);
+        sat *= ramp * ramp * (3.0 - 2.0 * ramp);    /* smoothstep */
+        for (int tries = 0; tries < 24; tries++) {
+            ink = QColor::fromHsvF(target, sat, val);
+            if (luminance(ink) >= sMinLuminance) {
+                break;
+            }
+            /* Brighten first and only desaturate once there is no headroom left,
+             * so the hue survives as long as possible. */
+            if (val < 1.0) {
+                val = qMin(1.0, val * 1.06);
+            } else if (sat > 0.02) {
+                sat *= 0.93;
+            } else {
+                break;
+            }
+        }
+    }
+    return qRgb(qRound(ink.red()   * coverage),
+                qRound(ink.green() * coverage),
+                qRound(ink.blue()  * coverage));
+}
+
+void LCDWidget::buildPaletteLut() {
+    if (m_paletteMode == PaletteOriginal) {
+        m_paletteLut.clear();
+        m_statusLut.clear();
+        return;
+    }
+    const bool mono = m_paletteMode == PaletteMono;
+
+    m_paletteLut.resize(1 << 16);
+    QRgb *lut = m_paletteLut.data();
+    for (int i = 0; i < 1 << 16; i++) {
+        int r, g, b;
+        unpack565(i, r, g, b);
+
+        const int lo = qMin(r, qMin(g, b));
+        const qreal alpha = 1.0 - lo / 255.0;
+        if (alpha <= 0.0) {
+            lut[i] = qRgb(0, 0, 0);     /* the white field becomes true black */
+            continue;
+        }
+        const int hi = qMax(r, qMax(g, b));
+        const qreal value = (hi - lo) / (255.0 - lo);   /* == max(ink) / 255 */
+        /* the ink's own colour, un-mixed from the white it was laid over */
+        const QColor src(qBound(0, qRound((r - 255) / alpha) + 255, 255),
+                         qBound(0, qRound((g - 255) / alpha) + 255, 255),
+                         qBound(0, qRound((b - 255) / alpha) + 255, 255));
+        lut[i] = inkOver(src.hueF(), value, hi ? (hi - lo) / qreal(hi) : 0.0, alpha, mono);
+    }
+    buildStatusLut();
+}
+
+/* ------------------------------------------------------------------------
+ *  The status bar
+ *
+ *  TI-OS draws its status bar as a dark band with light glyphs, which makes it
+ *  the one part of the screen that is already the right way round. Sent through
+ *  the inverting map above it comes out as the brightest large area on the
+ *  display -- a full-width band 30 rows deep, an eighth of the screen, at about
+ *  45% grey -- so it sits above everything the student reads as a glare source,
+ *  with its own text knocked down to 4.4:1 in the process.
+ *
+ *  This second map leaves the band the way round it already is. Brightness is
+ *  the mark here rather than ink coverage: anything at or below the bar's own
+ *  background falls to true black, and the glyphs come up to full-strength ink,
+ *  which takes the bar's text from 4.4:1 to the same 21:1 as the rest.
+ * ---------------------------------------------------------------------- */
+
+static const qreal sStatusFloor = 0.40;     /* source brightness that reads as bar, not glyph */
+static const qreal sStatusKnee = 0.12;      /* and how fast a glyph gates in above it */
+static const size_t sStatusStride = 7;      /* coprime with the 8-pixel character cell */
+static const size_t sStatusSamples = LCD_WIDTH / sStatusStride;
+static const size_t sStatusMinRows = 8;     /* smaller than this is not a bar */
+static const size_t sStatusMaxRows = 64;    /* larger than this is not a bar either.
+                                             * The measured bar is 30 rows, so this
+                                             * leaves room for a taller one while
+                                             * still being far short of a screen a
+                                             * program has drawn dark on purpose. */
+
+void LCDWidget::buildStatusLut() {
+    m_statusLut.resize(1 << 16);
+    QRgb *lut = m_statusLut.data();
+    const bool mono = m_paletteMode == PaletteMono;
+    for (int i = 0; i < 1 << 16; i++) {
+        int r, g, b;
+        unpack565(i, r, g, b);
+
+        const int hi = qMax(r, qMax(g, b));
+        const int lo = qMin(r, qMin(g, b));
+        const qreal value = hi / 255.0;
+        const qreal chroma = hi ? (hi - lo) / qreal(hi) : 0.0;
+        /* A glyph is anything that stands clear of the bar's own background --
+         * either by being brighter than it, or by having a colour where the bar
+         * has none. Gating on brightness alone would dim the battery and the
+         * low-battery warning, which are solid marks rather than half-covered
+         * ones, below the contrast floor the rest of the display holds to.
+         * Coverage then carries the mark's own brightness through unchanged, so
+         * a neutral glyph comes out exactly as it went in. */
+        const qreal bright = qBound(0.0, (value - sStatusFloor) / sStatusKnee, 1.0);
+        qreal ramp = qBound(0.0, (chroma - 0.15) / 0.40, 1.0);
+        ramp = ramp * ramp * (3.0 - 2.0 * ramp);
+        const qreal coverage = value * qMax(bright, ramp);
+        lut[i] = inkOver(QColor(r, g, b).hueF(), value, chroma, coverage, mono);
+    }
+}
+
+void LCDWidget::setPaletteMode(int mode) {
+    m_mutex.lock();
+    m_paletteMode = static_cast<PaletteMode>(mode);
+    buildPaletteLut();
+    m_mutex.unlock();
+    update();
+}
