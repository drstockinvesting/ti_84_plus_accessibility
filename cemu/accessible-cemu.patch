new file mode 100644
index 0000000..4d979c2
--- /dev/null
+++ b/gui/qt/magnifier.cpp
@@ -0,0 +1,59 @@
+#include "magnifier.h"
+
+#include <QtGui/QPainter>
+#include <QtGui/QPen>
+#include <QtGui/QColor>
+#include <QtGui/QKeyEvent>
+#include <QtWidgets/QApplication>
+
+Magnifier *magnifier = Q_NULLPTR;
+
+void Magnifier::setActive(bool on) {
+    if (m_active == on) {
+        return;
+    }
+    m_active = on;
+    /* Escape is the one way out that needs no aim at all, which matters here
+     * more than usual -- but it is also mapped to the calculator's own quit key,
+     * so it can only be claimed while the magnifier is actually up. Hence an
+     * application filter installed and removed with the state rather than a
+     * shortcut: it is ahead of every per-widget filter, it does not depend on
+     * which widget happens to hold focus (none of them take it on click), and
+     * while the magnifier is down it is not installed at all. */
+    if (on) {
+        qApp->installEventFilter(this);
+    } else {
+        qApp->removeEventFilter(this);
+    }
+    emit activeChanged(on);
+}
+
+bool Magnifier::eventFilter(QObject *obj, QEvent *event) {
+    if (m_active && event->type() == QEvent::KeyPress &&
+        static_cast<QKeyEvent *>(event)->key() == Qt::Key_Escape) {
+        setActive(false);
+        return true;
+    }
+    return QObject::eventFilter(obj, event);
+}
+
+QTransform Magnifier::transformFor(const QPointF &centre, const QRect &bounds) {
+    const qreal k = 1.0 - 1.0 / Factor;
+    const qreal cx = qBound(qreal(bounds.left()),  centre.x(), qreal(bounds.right()));
+    const qreal cy = qBound(qreal(bounds.top()),   centre.y(), qreal(bounds.bottom()));
+    return QTransform::fromTranslate(-cx * k, -cy * k) * QTransform::fromScale(Factor, Factor);
+}
+
+void Magnifier::paintFrame(QPainter &painter, const QRect &bounds) {
+    painter.save();
+    painter.resetTransform();
+    /* amber rather than white: it reads as a state marker instead of as content,
+     * and it stays visible against both the black screen and the dark keypad */
+    QPen pen{QColor(255, 199, 0)};
+    pen.setWidth(4);
+    pen.setJoinStyle(Qt::MiterJoin);
+    painter.setPen(pen);
+    painter.setBrush(Qt::NoBrush);
+    painter.drawRect(bounds.adjusted(2, 2, -2, -2));
+    painter.restore();
+}
diff --git a/gui/qt/magnifier.h b/gui/qt/magnifier.h
new file mode 100644
index 0000000..180e3ab
--- /dev/null
+++ b/gui/qt/magnifier.h
@@ -0,0 +1,68 @@
+#ifndef MAGNIFIER_H
+#define MAGNIFIER_H
+
+#include <QtCore/QObject>
+#include <QtCore/QPointF>
+#include <QtCore/QRect>
+#include <QtGui/QTransform>
+
+QT_BEGIN_NAMESPACE
+class QPainter;
+QT_END_NAMESPACE
+
+/* Press-and-hold magnifier, for a student who reads this calculator at up to
+ * 10x and needs to look closely at one part of it without resizing the window.
+ *
+ * There is ONE shared instance rather than one per widget, because the
+ * calculator is a single object to the person using it: a long press on the
+ * screen magnifies the screen and the keypad together. The gesture lives on the
+ * LCD alone and deliberately not on the keypad. CEmu delivers real press and
+ * release events to the emulated hardware, so holding a key repeats it exactly
+ * as a physical TI-84 does; a long press on the keypad would have to take that
+ * away, and the user chose key repeat over a second place to start the zoom.
+ *
+ * Each host widget keeps its own centre, so the screen stays parked on whatever
+ * was being read while the pointer moves down to the keypad.
+ */
+class Magnifier : public QObject {
+    Q_OBJECT
+
+public:
+    /* 4x, and 550 ms, are what the earlier macOS build used and what the
+     * student is already used to. Slop is how far the pointer may drift and
+     * still count as held still -- generous, because a hand that cannot see the
+     * pointer well does not hold it perfectly still. */
+    static constexpr qreal Factor = 4.0;
+    static constexpr int HoldMs = 550;
+    static constexpr qreal SlopPx = 14.0;
+
+    explicit Magnifier(QObject *parent = Q_NULLPTR) : QObject{parent} {}
+
+    bool isActive() const { return m_active; }
+    void setActive(bool on);
+    void toggle() { setActive(!m_active); }
+
+    /* Apple's pointer-centred mapping. With the origin at c * (1 - 1/Z) the
+     * source point under the pointer is exactly c, so the whole widget stays
+     * reachable as the pointer sweeps across it and the magnified rect never
+     * leaves the bounds. Because the point under the pointer is unchanged, hit
+     * testing needs no inverse and no host has to be taught about the zoom. */
+    static QTransform transformFor(const QPointF &centre, const QRect &bounds);
+
+    /* A high-contrast border, so it is never a mystery that the view is zoomed.
+     * Drawn without the transform, hard against the edge of the widget. */
+    static void paintFrame(QPainter &painter, const QRect &bounds);
+
+signals:
+    void activeChanged(bool on);
+
+protected:
+    bool eventFilter(QObject *obj, QEvent *event) Q_DECL_OVERRIDE;
+
+private:
+    bool m_active = false;
+};
+
+extern Magnifier *magnifier;
+
+#endif
