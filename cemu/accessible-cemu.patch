+// Issue 3. The two panels are sized by different rules -- a fixed-size screen and an
+// aspect-locked keypad -- so they line up at exactly one window size. Rather than
+// re-introduce a bitmap skin, derive the single `Screen/scale` from the window, which
+// is what lcdAdjust() already drives everything from. The whole calculator then grows
+// and shrinks as one object, keeping the crisp vector keypad.
+void MainWindow::scaleToWindow() {
+    if (!m_setup || m_scaling || !m_scaleWithWindow) {
+        return;
+    }
+    // FULLSCREEN_ALL is still an ordinary dock layout, just a bigger one, so it
+    // should scale too. FULLSCREEN_LCD is not: there the LCD is reparented out into
+    // its own window and the dock geometry here is meaningless.
+    if (m_fullscreen == FULLSCREEN_LCD || !ui->checkSkin->isChecked()) {
+        return;
+    }
+    DockWidget *keypadDock = findChild<DockWidget *>(QStringLiteral("keypadWidget_dock"));
+    if (!keypadDock || !ui->screenDock->isVisible() || !keypadDock->isVisible()) {
+        return;
+    }
+    if (ui->screenDock->isFloating() || keypadDock->isFloating()) {
+        return;
+    }
+
+    // CE proportions, straight out of CEmu's own numbers: the screen widget is
+    // 440x351 at scale 1, and the keypad's base rect is 162x238, so at the screen's
+    // width it is 440 * 238/162 = 646.4 tall. The stack is 440 x 997.4, which is
+    // aspect 0.4411 against the real calculator's 84/190 = 0.4421.
+    const double kScreenW = 440.0, kScreenH = 351.0;
+    const double kTotalH = kScreenH + kScreenW * 238.0 / 162.0;
+
+    const int availW = qMin(ui->screenDock->width(), keypadDock->width());
+    const int availH = ui->screenDock->height() + keypadDock->height();
+    if (availW <= 0 || availH <= 0) {
+        return;
+    }
+
+    int pct = static_cast<int>(qMin(availW / kScreenW, availH / kTotalH) * 100.0);
+    pct = qBound(10, pct, 800);
+
+    const int screenH = qRound(kScreenH * pct / 100.0);
+    if (pct == ui->scaleLCD->value() && ui->screenDock->height() == screenH) {
+        return;   // already settled -- stopping here is what keeps this from looping
+    }
+
+    m_scaling = true;
+    if (pct != ui->scaleLCD->value()) {
+        ui->scaleLCD->blockSignals(true);
+        ui->scaleLCD->setValue(pct);
+        ui->scaleLCD->blockSignals(false);
+        m_config->setValue(SETTING_SCREEN_SCALE, pct);
+    }
+    lcdAdjust();
+    resizeDocks({ui->screenDock, keypadDock}, {screenH, availH - screenH}, Qt::Vertical);
+    m_scaling = false;
+}
