+/* ------------------------------------------------------------------------
+ *  High-contrast palette
+ *
+ *  This build is for a student with Stargardt disease who reads the screen at
+ *  up to 10x magnification, so TI's black-ink-on-a-white-field display is a
+ *  page-sized glare source. Everything below remaps each frame to cool ink on
+ *  true black.
+ *
+ *  The model is ink on paper. A TI pixel is some coverage of one coloured ink
+ *  laid over a white background, so
+ *
+ *      alpha = 1 - min(r,g,b)/255          how much ink is on this pixel
+ *      ink   = (pixel - 255)/alpha + 255   the ink's own colour, un-mixed
+ *
+ *  By construction min(ink) is exactly 0, so the ink is always fully saturated
+ *  and carries just two free numbers: hue and value. Black ink falls out as
+ *  value 0, which is what lets grey text and anti-aliased edges come through
+ *  as a clean grey ramp rather than a coloured halo.
+ *
+ *  Output is alpha * newInk over black, so coverage survives the remap: the
+ *  white field becomes true black, and a faint anti-aliased edge stays faint
+ *  instead of blooming into a ring around every glyph.
+ * ---------------------------------------------------------------------- */
+
+/* Source hue -> replacement hue, in degrees. Cool hues keep their identity and
+ * the warm ones are folded into the gaps between them, which is the "cool
+ * first, warm last" priority this was asked for. Folding 360 degrees of source
+ * into 190 degrees of cool costs separation somewhere, so the anchors are
+ * placed to spend it on the colours that are rarely used: TI-OS assigns
+ * Y1..Y5 blue, red, black, magenta and green, and those five stay far apart
+ * while orange and brown -- the two warmest -- end up as neighbours. */
+static const struct { int from, to; } sHueAnchors[] = {
+    {   0, 325 },   /* red     -> pink    */
+    {  31, 248 },   /* orange  -> indigo  */
+    {  60, 163 },   /* yellow  -> aqua    */
+    { 120, 138 },   /* green   -> green   */
+    { 201, 190 },   /* ltblue  -> cyan    */
+    { 240, 222 },   /* blue    -> blue    */
+    { 300, 277 },   /* magenta -> purple  */
+};
+
+/* Nearest anchor wins, rather than interpolating between them. Interpolation
+ * looks tidier but the table is deliberately not monotone -- red sits next to
+ * magenta at one end and orange at the other -- so a smooth sweep between two
+ * anchors would pass straight through a third anchor's colour. Brown, whose
+ * hue is 9 degrees off orange's, came out indistinguishable from navy that
+ * way. Snapping costs some banding on photographic content, which the
+ * calculator does not show, and buys separation on content it does. */
+static qreal remapHue(qreal hue) {
+    const size_t count = sizeof(sHueAnchors) / sizeof(sHueAnchors[0]);
+    qreal best = sHueAnchors[0].to, bestDist = 360.0;
+    for (size_t i = 0; i < count; i++) {
+        qreal dist = qAbs(hue - sHueAnchors[i].from);
+        dist = qMin(dist, 360.0 - dist);
+        if (dist < bestDist) {
+            bestDist = dist;
+            best = sHueAnchors[i].to;
+        }
+    }
+    return best;
+}
+
+/* Relative luminance, so every ink can be held above a contrast ratio on black.
+ * 4.5:1 is the floor: blue is intrinsically dark and pinning it any higher
+ * washed navy and blue into the same colour. */
+static const qreal sMinLuminance = 0.175;   /* (4.5 * 0.05) - 0.05 */
+
+static qreal luminance(const QColor &c) {
+    static qreal linear[256];
+    static bool ready = false;
+    if (!ready) {
+        for (int i = 0; i < 256; i++) {
+            const qreal v = i / 255.0;
+            linear[i] = v <= 0.03928 ? v / 12.92 : std::pow((v + 0.055) / 1.055, 2.4);
+        }
+        ready = true;
+    }
+    return 0.2126 * linear[c.red()] + 0.7152 * linear[c.green()] + 0.0722 * linear[c.blue()];
+}
+
+/* The panel hands us RGB565 widened by bit replication (lcd_argb8888out), so
+ * keying a table on the 565 form is exact for real frames and no worse than a
+ * rounding for anything else. 64K entries keeps the draw path to one load per
+ * pixel. */
+static void unpack565(int i, int &r, int &g, int &b) {
+    r = (i >> 11 & 0x1F) << 3; r |= r >> 5;
+    g = (i >>  5 & 0x3F) << 2; g |= g >> 6;
+    b = (i       & 0x1F) << 3; b |= b >> 5;
+}
